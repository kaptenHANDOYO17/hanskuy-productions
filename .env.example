# =====================================================================
#  Salin file ini menjadi ".env.local", lalu isi nilainya.
#  Di Vercel: isi nilai yang SAMA di Settings → Environment Variables.
# =====================================================================

# --- WAJIB: Supabase (Project Settings → API / API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-dengan-anon-atau-publishable-key-anda

# --- OPSIONAL: tombol "Lanjutkan dengan Google" ---
# Isi "true" HANYA setelah Google diaktifkan di Supabase (lihat PANDUAN.md).
NEXT_PUBLIC_AUTH_GOOGLE=false

# --- OPSIONAL: anti-bot Cloudflare Turnstile ---
# Isi HANYA jika CAPTCHA juga diaktifkan di Supabase. Keduanya harus aktif bersamaan.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
